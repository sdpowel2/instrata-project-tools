# Local runs of the worker / CLI. On Fly these are secrets and [env] in fly.toml.

# Supabase Postgres (Project Tools). Session pooler URL from Supabase > Connect.
# Leave unset to use a local SQLite file (data/leadfinder.db) for experiments.
DATABASE_URL=
# Checks the signed-in admin's Supabase token on the document and /bc/authorize endpoints
SUPABASE_URL=
SUPABASE_ANON_KEY=
# DOWNLOAD_SIGNING_KEY=   (optional; random per process if unset)

# SAM.gov public API key (SAM.gov > Account Details > API Key). Expires every 90 days.
SAM_API_KEY=
# Contact email shown in the HTTP User-Agent sent to SAM.gov, Bonfire and the Census geocoder
HTTP_USER_AGENT_CONTACT=

# Autodesk Platform Services app for BuildingConnected (aps.autodesk.com > your hub > app).
# Application type: Traditional Web App. Callback URL must match APS_CALLBACK_URL exactly.
APS_CLIENT_ID=
APS_CLIENT_SECRET=
# APS_CALLBACK_URL=http://localhost:8080/oauth/callback

# Project Tools origin (CORS + where the OAuth callback returns) and this worker's own URL
# APP_URL=http://localhost:5173
# PUBLIC_URL=http://localhost:8080

# Only needed if the email_alerts adapter is enabled
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# Claude API: triage of bid documents
ANTHROPIC_API_KEY=
# TRIAGE_BUDGET_USD=10
# LEADFINDER_DATA_DIR=./data
# SCHEDULE_HOUR_ET=6   (negative turns the daily run off)
