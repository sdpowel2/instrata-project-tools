# Copy to .env for local dev (never commit .env). In production these are set as
# runtime secrets (e.g. `fly secrets set ...`), never as build args.

# Public base URL of THIS server, used to build OAuth metadata + redirect URIs.
# Local dev: http://localhost:8080   Prod: https://<host>
BASE_URL=http://localhost:8080

# Listen port (default 8080).
PORT=8080

# ── Procore Developer app (developers.procore.com) ───────────────────────────
# One app, Authorization Code grant. Redirect URI must be <BASE_URL>/procore/callback.
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
# Sandbox for dev, production for real data.
#   Dev:  https://sandbox.procore.com
#   Prod: https://api.procore.com  (login host is https://login.procore.com)
PROCORE_BASE_URL=https://sandbox.procore.com
# OAuth authorize/token host. Sandbox serves OAuth from the same host, so this
# can be left unset in dev. In production set it to https://login.procore.com.
# PROCORE_AUTH_URL=https://login.procore.com

# ── Token store (dedicated Postgres — NOT the app's Supabase) ─────────────────
# Postgres connection string for the encrypted per-user Procore token store.
DATABASE_URL=

# ── Secrets ──────────────────────────────────────────────────────────────────
# 32-byte key (base64 or hex) for AES-256-GCM encryption of Procore tokens at
# rest. Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
# SENSITIVE — lives only in env/secret manager, never in the DB or repo.
TOKEN_ENCRYPTION_KEY=

# Secret used to sign the short-lived JWTs THIS server issues to Claude. SENSITIVE.
# Generate the same way as TOKEN_ENCRYPTION_KEY.
SESSION_SECRET=

# ── Optional tuning ──────────────────────────────────────────────────────────
# LOG_LEVEL=info
# ACCESS_TOKEN_TTL_SECONDS=3600
# PROCORE_MAX_CONCURRENCY=5
