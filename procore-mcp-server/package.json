{
  "name": "instrata-procore-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only, per-user MCP server for Procore. Each team member authenticates with their own Procore account (OAuth 2.1), so every call mirrors exactly their own Procore permissions. See Product Spec/procore-mcp-spec.md.",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jose": "^5.9.6",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3"
  }
}
