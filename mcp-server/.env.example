# Copy to .env for local dev (never commit .env). In production these are set
# via `fly secrets set ...` and injected at runtime.

# Supabase project URL, e.g. https://zeuceafbaufpuwpczcth.supabase.co
SUPABASE_URL=

# Public anon key (same value as the app's VITE_SUPABASE_ANON_KEY). Used as the
# PostgREST apikey — safe to expose, but keep it out of git anyway.
SUPABASE_ANON_KEY=

# Legacy HS256 JWT secret — Supabase Dashboard → Settings → API → JWT Keys
# ("Legacy JWT Secret" / "Previous Key"). Used to mint short-lived per-user
# tokens and this server's own `mcp_service` role token. SENSITIVE — treat like
# a service-role key.
SUPABASE_JWT_SECRET=

# This server's public origin. It is the OAuth issuer and the base for every
# OAuth URL, so it must match what clients type EXACTLY (no trailing slash, no
# path). https only; http is accepted for localhost.
#   production: https://instrata-project-tools-mcp.fly.dev
#   local dev:  http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080

# Optional: pre-registered OAuth client for the claude.ai connector's Advanced
# settings (bypasses Dynamic Client Registration). Leave both unset to disable.
# Omit the secret to make it a public client.
# OAUTH_ADMIN_CLIENT_ID=
# OAUTH_ADMIN_CLIENT_SECRET=

# Optional tuning
# PORT=8080
# ACCESS_TOKEN_TTL_SECONDS=3600
# REFRESH_TOKEN_TTL_SECONDS=2592000
# AUTH_CODE_TTL_SECONDS=600
# JWT_TTL_SECONDS=300
# RATE_LIMIT_PER_MIN=120
