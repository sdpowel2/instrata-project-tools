# Copy to .env for local dev (never commit .env). In production these are set
# via `fly secrets set ...` and injected at runtime.

# Supabase project URL, e.g. https://zeuceafbaufpuwpczcth.supabase.co
SUPABASE_URL=

# Public anon key (same value as the app's VITE_SUPABASE_ANON_KEY). Used as the
# PostgREST apikey — safe to expose, but keep it out of git anyway.
SUPABASE_ANON_KEY=

# Legacy HS256 JWT secret — Supabase Dashboard → Settings → API → JWT Keys
# ("Legacy JWT Secret" / "Previous Key"). Used ONLY to mint short-lived
# per-user tokens. SENSITIVE — treat like a service-role key.
SUPABASE_JWT_SECRET=

# Optional tuning
# PORT=8080
# JWT_TTL_SECONDS=300
# RATE_LIMIT_PER_MIN=120
