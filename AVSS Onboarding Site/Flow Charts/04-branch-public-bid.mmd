%% Instrata Pre-Sales Flow — Branch 4: Public Bid
%% Public agency bid; lowest-cost-wins. Pursued selectively where we have relationship or win likelihood.
%% Structurally identical to Branch 3 (Bid). Only rollover entry differs: Budget only (not Design).

flowchart TD
    P1[Phase 1: Intake & Qualification<br/>Type set to: Public Bid]
    Rollover([Rollover from Budget])

    P1 --> P2[Phase 2: Discovery & RFI]
    Rollover -.-> P3

    P2 --> M2_1[Intro Call with Sales AM]
    M2_1 --> M2_2[Document Discovery]
    M2_2 --> M2_3[Takeoffs]
    M2_3 --> D1[/D1: Takeoff Document/]
    D1 --> M2_4[RFIs Created]
    M2_4 --> D2[/D2: Submitted RFIs/]
    D2 --> M2_5[Scope Draft Assembled]
    M2_5 --> D3[/D3: Scope Draft/]

    D3 --> P3[Phase 3: Design & Engineering]
    P3 --> M3_1[Review/Markup Consultant One-Lines]
    M3_1 --> D4[/D4: One-Line Markup as Functional Sketch/]
    D4 --> M3_2[Design Notes]
    M3_2 --> D5[/D5: Design Notes/]
    D5 --> M3_3[Initial BoM Developed - Pre-RFI Answers]

    M3_3 --> P4[Phase 4: Pricing & Proposal]
    P4 --> M4_1[Cost Roll-Up Complete]
    M4_1 --> M4_2[Final BoM Captured - Incl. RFI Answers]
    M4_2 --> M4_3[Margin / Pricing Strategy Applied]
    M4_3 --> M4_4[Proposal Document Assembled]
    M4_4 --> M4_5[Internal Proposal Review]
    M4_5 --> D6[/D6: Final Proposal/]

    D6 --> P5[Phase 5: Submission & Negotiation]
    P5 --> M5_1[Proposal Delivered to Client]
    M5_1 --> M5_2[Follow-Up]
    M5_2 --> M5_3[Revisions - Re-Bid/Clarifications/Scope]
    M5_3 --> D7[/D7: Revised Proposal/]
    D7 --> M5_4[Award]

    M5_4 --> P6[Phase 6: Award & Handoff]
    P6 --> M6_1[Contract/PO Received]
    M6_1 --> M6_2[Contract Review / Red-Lines]
    M6_2 --> M6_3[Contract Countersigned]
    M6_3 --> M6_4[Pre-Sales to Post-Sales Handoff]
    M6_4 --> D8[/D8: Post-Sales Handoff Package/]
    D8 --> End([Won → Post-Sales])

    classDef phase fill:#1e3a5f,stroke:#0f1e30,color:#fff
    classDef milestone fill:#e8eef5,stroke:#1e3a5f,color:#1e3a5f
    classDef deliverable fill:#fff4e6,stroke:#d97706,color:#7c2d12
    classDef rollover fill:#fef3c7,stroke:#d97706,color:#7c2d12
    classDef terminal fill:#dcfce7,stroke:#16a34a,color:#14532d

    class P1,P2,P3,P4,P5,P6 phase
    class M2_1,M2_2,M2_3,M2_4,M2_5,M3_1,M3_2,M3_3,M4_1,M4_2,M4_3,M4_4,M4_5,M5_1,M5_2,M5_3,M5_4,M6_1,M6_2,M6_3,M6_4 milestone
    class D1,D2,D3,D4,D5,D6,D7,D8 deliverable
    class Rollover rollover
    class End terminal
