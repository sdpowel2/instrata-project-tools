%% Instrata Pre-Sales Flow — Branch 5: Budget
%% Placeholder pricing for client's future planning / funding requests.
%% Rarely revised. Almost always re-enters as Bid / Public Bid / Design-Build at Phase 3.

flowchart TD
    P1[Phase 1: Intake & Qualification<br/>Type set to: Budget]

    P1 --> P2[Phase 2: Discovery]
    P2 --> M2_1[Intro Call with Sales AM]
    M2_1 --> M2_2[Discovery Call with Client - Optional]
    M2_2 --> M2_3[Brief Scope Draft Assembled - Room Types]
    M2_3 --> D1[/D1: Scope Draft/]

    D1 --> P3[Phase 3: Pricing & Proposal]
    P3 --> M3_1[Cost Roll-Up Complete]
    M3_1 --> M3_2[Proposal Document Assembled]
    M3_2 --> M3_3[Internal Proposal Review]
    M3_3 --> D2[/D2: Final Proposal/]

    D2 --> P4[Phase 4: Submission & Transition]
    P4 --> M4_1[Proposal Submitted to Client]
    M4_1 --> M4_2[Client Scope Review]
    M4_2 --> M4_3[Transition to Bid / Public Bid / Design-Build]
    M4_3 --> End([Re-Enter Target Branch @ Phase 3])

    classDef phase fill:#1e3a5f,stroke:#0f1e30,color:#fff
    classDef milestone fill:#e8eef5,stroke:#1e3a5f,color:#1e3a5f
    classDef deliverable fill:#fff4e6,stroke:#d97706,color:#7c2d12
    classDef terminal fill:#dcfce7,stroke:#16a34a,color:#14532d

    class P1,P2,P3,P4 phase
    class M2_1,M2_2,M2_3,M3_1,M3_2,M3_3,M4_1,M4_2,M4_3 milestone
    class D1,D2 deliverable
    class End terminal
