%% Instrata Pre-Sales Flow — Branch 2: Design-Build
%% Client commits to us designing and installing.
%% Entry points: new lead at Phase 2, or rollover from Design/Budget at Phase 3.

flowchart TD
    P1[Phase 1: Intake & Qualification<br/>Type set to: Design-Build]
    Rollover([Rollover from Design or Budget])

    P1 --> P2[Phase 2: Discovery]
    Rollover -.-> P3

    P2 --> M2_1[Intro Call with Sales AM]
    M2_1 --> M2_2[Discovery Call with Client]
    M2_2 --> M2_3[Site Walk Conducted]
    M2_3 --> M2_4[Scope Draft Assembled]
    M2_4 --> D1[/D1: Scope Draft/]

    D1 --> P3[Phase 3: Design & Engineering]
    P3 --> M3_1[Functional Sketch]
    M3_1 --> D2[/D2: Functional Sketch/]
    D2 --> M3_2[BoM Developed - in DTools]

    M3_2 --> P4[Phase 4: Pricing & Proposal]
    P4 --> M4_1[Cost Roll-Up Complete]
    M4_1 --> M4_2[Margin / Pricing Strategy Applied]
    M4_2 --> M4_3[Proposal Document Assembled]
    M4_3 --> M4_4[Internal Proposal Review]
    M4_4 --> D3[/D3: Final Proposal/]

    D3 --> P5[Phase 5: Submission & Negotiation]
    P5 --> M5_1[Proposal Delivered to Client]
    M5_1 --> M5_2[Client Scope Review]
    M5_2 --> M5_3[Revisions - Scope/Price/VE]
    M5_3 --> D4[/D4: Revised Proposal/]
    D4 --> M5_4[Final Proposal Accepted - Confirmed to Win]

    M5_4 --> P6[Phase 6: Award & Handoff]
    P6 --> M6_1[Contract/PO Received]
    M6_1 --> M6_2[Contract Review / Red-Lines]
    M6_2 --> M6_3[Contract Countersigned]
    M6_3 --> M6_4[Pre-Sales to Post-Sales Handoff]
    M6_4 --> D5[/D5: Post-Sales Handoff Package/]
    D5 --> End([Won → Post-Sales])

    classDef phase fill:#1e3a5f,stroke:#0f1e30,color:#fff
    classDef milestone fill:#e8eef5,stroke:#1e3a5f,color:#1e3a5f
    classDef deliverable fill:#fff4e6,stroke:#d97706,color:#7c2d12
    classDef rollover fill:#fef3c7,stroke:#d97706,color:#7c2d12
    classDef terminal fill:#dcfce7,stroke:#16a34a,color:#14532d

    class P1,P2,P3,P4,P5,P6 phase
    class M2_1,M2_2,M2_3,M2_4,M3_1,M3_2,M4_1,M4_2,M4_3,M4_4,M5_1,M5_2,M5_3,M5_4,M6_1,M6_2,M6_3,M6_4 milestone
    class D1,D2,D3,D4,D5 deliverable
    class Rollover rollover
    class End terminal
